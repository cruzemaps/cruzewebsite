{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "cruze-metrics-guard",
  "main": "src/index.ts",
  "compatibility_date": "2026-04-17",
  "observability": { "enabled": true },
  // Path-scoped route only: this Worker answers api.cruzemaps.com/metrics and nothing else.
  // Every other path on api.cruzemaps.com (/, /health, /readyz, /api/*) still reaches the
  // cloudflared tunnel. This is a route, never a custom_domain, which would take the whole host.
  // account_id is not pinned here (repo convention); pass CLOUDFLARE_ACCOUNT_ID at deploy.
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "api.cruzemaps.com/metrics", "zone_name": "cruzemaps.com" }
  ]
}
